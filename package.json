{
  "name": "imperio-urbano",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @imperio/web",
    "build": "npm run build -w @imperio/web",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
